APP_NAME=NAMTECH
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Public website address (the React front end). The API is served under APP_URL/api/v1.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=namtech
DB_USERNAME=namtech
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
ADMIN_ENFORCE_2FA=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@namtech.ac"
NAMTECH_ENQUIRY_RECIPIENTS="contact@namtech.ac"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# First Super Admin created by the seeder. Leave the password empty to generate one.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Comma-separated proxy IPs/CIDRs in front of the app (load balancer/CDN), or *
TRUSTED_PROXIES=

PAGE_CACHE_ENABLED=true
PAGE_CACHE_TTL=3600
MEDIA_MAX_UPLOAD_KB=10240
EMBED_HOSTS=www.youtube-nocookie.com,www.youtube.com,player.vimeo.com,my.matterport.com,kuula.co
MEDIA_URL=

# React front end on the same site: the CMS signs in with Laravel's session cookie.

# Inertia DevTools records every request to storage/inertia-devtools; off unless needed.
INERTIA_DEVTOOLS_ENABLED=false
