# NAMTECH website settings. Copy to backend/.env and fill in the values marked "← fill in".
APP_NAME=NAMTECH
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# ← fill in: your live address, exactly as visitors type it (https, with or without www)
APP_URL=https://www.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# deploy/setup-ec2.sh creates this database and fills in the password.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=namtech
DB_USERNAME=namtech
DB_PASSWORD=

# Sessions, cache and the queue are stored in MySQL (the sessions, cache and jobs tables).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
ADMIN_ENFORCE_2FA=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ← fill in: the SMTP account that sends enquiry notifications (Amazon SES or your mail provider, port 465).
# EC2 blocks outgoing port 25, so use 465 or 587.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@namtech.ac"
MAIL_FROM_NAME="${APP_NAME}"
# Who receives website enquiries (comma-separated)
NAMTECH_ENQUIRY_RECIPIENTS="contact@namtech.ac"

TRUSTED_PROXIES=
PAGE_CACHE_ENABLED=true
PAGE_CACHE_TTL=3600
MEDIA_MAX_UPLOAD_KB=10240
EMBED_HOSTS=www.youtube-nocookie.com,www.youtube.com,player.vimeo.com,my.matterport.com,kuula.co
MEDIA_URL=

# Node.js renders public pages to finished HTML for search engines and a fast first paint.
INERTIA_SSR_ENABLED=true
INERTIA_DEVTOOLS_ENABLED=false
